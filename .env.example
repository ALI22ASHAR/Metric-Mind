# ==============================================================================
# MetricMind - Environment Configuration Example
# ==============================================================================

# Application Metadata
PROJECT_NAME="MetricMind"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
REQUIRE_AUTH=False

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated list of origins or wildcard)
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000", "http://127.0.0.1:8000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="metricmind"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"

# LLM Configuration
# LLM_PROVIDER="deepseek"
# NVIDIA_API_KEY="nvapi-..."
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_MODEL="deepseek-ai/deepseek-v4-pro-0813"

# Optional explicit DB URL overrides (if provided, these will be preferred)
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/metricmind"
# SYNC_DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/metricmind"

# Logging Configuration
LOG_LEVEL="INFO"
